# --- Rust / Cargo ---
/target/
**/*.rs.bk
*.pdb

# Keep Cargo.lock: this workspace ships binaries, so a locked build is wanted.
# (Remove the next line if you ever publish these as libraries.)
# Cargo.lock

# --- webrev runtime artifacts ---
# SQLite databases produced by scans
*.db
*.db-journal
*.db-wal
*.db-shm
# JSON reports exported by `webrev report` / the TUI
*-report.json
webrev-report.json
# Disposable browser profiles land in the system temp dir, but ignore any
# that leak into the working tree.
webrev-profile-*/

# --- editors / tooling ---
/.idea/
/.vscode/
*.iml
.rust_info.json
/flycheck0

# --- OS cruft ---
.DS_Store
Thumbs.db
desktop.ini
