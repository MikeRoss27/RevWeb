# --- Rust / Cargo ---
/target/
**/*.rs.bk
*.pdb

# Keep Cargo.lock: this workspace ships binaries, so a locked build is wanted.
# (Remove the next line if you ever publish these as libraries.)
# Cargo.lock

# --- webrev runtime artifacts ---
# JSON reports exported by `webrev report` / the TUI
*-report.json
webrev-report.json
# Disposable browser profiles land in the system temp dir, but ignore any
# that leak into the working tree.
webrev-profile-*/

# --- editors / tooling ---
/.idea/
/.vscode/
*.iml
.rust_info.json
/flycheck0

# --- OS cruft ---
.DS_Store
Thumbs.db
desktop.ini

# Local Python helper bytecode
__pycache__/

# Scratch space for fetching/exploring third-party sources before they are
# pinned into benchmarks/external-corpus/v1/sources.json. Never committed:
# see benchmarks/external-corpus/v1/README.md ("No third-party code is
# committed").
/.ext-work/

# Archived benchmark evidence is pinned by SHA256SUMS and must be committed even
# though it matches the report patterns above.
!benchmarks/**/*-report.json
!benchmarks/**/webrev-report.json

# Claude Code local state
.claude/
